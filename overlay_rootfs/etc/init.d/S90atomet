#!/bin/sh
#
# atometd
#

DAEMON=/usr/bin/atometd
DAEMON_SD=/media/mmc/atometd
PIDFILE=/var/run/atometd.pid

# atomet 同梱のドライバ (post_build.sh でビルドされ rootfs に配置)
DRV_DIR=/lib/modules/atomet

# SD カードにバイナリがあればそちらを優先（開発用）
if [ -f "$DAEMON_SD" ] && [ -x "$DAEMON_SD" ]; then
    DAEMON="$DAEMON_SD"
fi

[ -f "$DAEMON" ] || exit 0

# Pick a kernel module: SD-card override > rootfs-bundled.
# (SD-card override is for dev use — drop a known-good .ko at /media/mmc/.)
pick_module() {
    name="$1"
    if [ -f "/media/mmc/$name" ]; then
        echo "/media/mmc/$name"
    else
        echo "$DRV_DIR/$name"
    fi
}

load_modules() {
    isp_ko=$(pick_module tx-isp-t31.ko)
    echo "  insmod $isp_ko"
    insmod "$isp_ko" isp_clk=100000000

    insmod /atom/system/driver/avpu.ko
    insmod /atom/system/driver/sinfo.ko
    insmod /atom/system/driver/audio.ko spk_gpio=-1
    insmod /atom/system/driver/sample_pwm_core.ko
    insmod /atom/system/driver/sample_pwm_hal.ko
    insmod /atom/system/driver/speaker_ctl.ko

    #sensor_ko=$(pick_module sensor_gc2053_t31.ko)
    #echo "  insmod $sensor_ko"
    #insmod "$sensor_ko" data_interface=1
    insmod /atom/system/driver/sensor_gc2053_t31.ko data_interface=1
}

start() {
    cp /atom/etc/sensor/gc2053-t31.bin /media/mmc/gc2053-t31.bin
    echo "Loading kernel modules..."
    load_modules
    echo "Starting atometd..."
    "$DAEMON" &
    echo $! > "$PIDFILE"
    echo "OK"
}

stop() {
    echo "Stopping atometd..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    echo "OK"
}

case "$1" in
    start)          start ;;
    stop)           stop ;;
    restart|reload) stop; start ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit 0
